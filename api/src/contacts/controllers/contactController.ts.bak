import { Request, Response } from 'express';
import { manageContactsService, ManageContactRequest, CreateUserNoteRequest, UpdateUserNoteRequest } from '../services/ManageContacts';
import { contactCreationService, CreateContactRequest } from '../services/createContacts';
import { bulkAddContactsService, FieldMapping } from '../services/bulkAddContacts';
import { contactDeletionService } from '../services/deleteContacts';
import { conversationManager } from '../../agentCommunication/sms/services/conversationManager';
import { smsChannelFinder } from '../utilities/findContactMods/smsChannelFind';
import multer from 'multer';

export class ContactController {
  
  async createContact(req: Request, res: Response): Promise<void> {
    try {
      const tenantId = req.tenantId!; // Set by authenticateEither middleware
      const { phoneNumber, name, email, notes } = req.body;

      console.log(`=📞 Creating contact for tenant ${tenantId}`, { phoneNumber, name, email });

      // Validate phoneNumber is provided
      if (!phoneNumber) {
        res.status(400).json({
          error: 'Missing required field',
          message: 'phoneNumber is required'
        });
        return;
      }

      const request: CreateContactRequest = {
        tenantId,
        phoneNumber,
        name,
        email,
        notes
      };

      const contactId = await contactCreationService.createContact(request);

      // Auto-create conversation for new contact to ensure it appears in conversations page
      const conversationId = await conversationManager.findOrCreateConversation(tenantId, contactId);

      console.log(`✅ Successfully created contact ${contactId} with conversation ${conversationId}`);
      
      res.status(201).json({
        success: true,
        message: 'Contact created successfully',
        contactId,
        conversationId
      });

    } catch (error) {
      console.error('❌ Error in createContact:', error);
      
      res.status(500).json({
        error: 'Internal server error',
        message: error instanceof Error ? error.message : 'Unknown error occurred'
      });
    }
  }

  async manageContact(req: Request, res: Response): Promise<void> {
    try {
      const tenantId = req.tenantId!; // Set by authenticateEither middleware
      const { contactId } = req.params;
      const updates = req.body;

      console.log(`=' Managing contact ${contactId} for tenant ${tenantId}`, updates);

      // Validate required parameters
      if (!contactId) {
        res.status(400).json({
          error: 'Missing required parameters',
          message: 'contactId is required'
        });
        return;
      }

      // Validate that we have some updates to make
      if (!updates || Object.keys(updates).length === 0) {
        res.status(400).json({
          error: 'No updates provided',
          message: 'Request body must contain fields to update'
        });
        return;
      }

      const request: ManageContactRequest = {
        tenantId,
        contactId,
        updates
      };

      await manageContactsService.updateContact(request);

      console.log(` Successfully managed contact ${contactId}`);
      
      res.status(200).json({
        success: true,
        message: 'Contact updated successfully',
        contactId
      });

    } catch (error) {
      console.error('L Error in manageContact:', error);
      
      res.status(500).json({
        error: 'Internal server error',
        message: error instanceof Error ? error.message : 'Unknown error occurred'
      });
    }
  }

  async getContact(req: Request, res: Response): Promise<void> {
    try {
      const { tenantId, contactId } = req.params;

      console.log(`=� Getting contact ${contactId} for tenant ${tenantId}`);

      // Validate required parameters
      if (!tenantId || !contactId) {
        res.status(400).json({
          error: 'Missing required parameters',
          message: 'tenantId and contactId are required'
        });
        return;
      }

      const contact = await manageContactsService.getContact(tenantId, contactId);

      console.log(` Successfully retrieved contact ${contactId}`);
      
      res.status(200).json({
        success: true,
        contact
      });

    } catch (error) {
      console.error('L Error in getContact:', error);
      
      if (error instanceof Error && error.message === 'Contact not found') {
        res.status(404).json({
          error: 'Contact not found',
          message: 'The specified contact does not exist'
        });
        return;
      }
      
      res.status(500).json({
        error: 'Internal server error',
        message: error instanceof Error ? error.message : 'Unknown error occurred'
      });
    }
  }

  async bulkUploadStep1(req: Request, res: Response): Promise<void> {
    try {
      const { tenantId } = req.params;
      const file = req.file;

      console.log(`📋 Bulk upload step 1 for tenant ${tenantId}`);

      // Validate required parameters
      if (!tenantId) {
        res.status(400).json({
          error: 'Missing required parameters',
          message: 'tenantId is required'
        });
        return;
      }

      // Validate file upload
      if (!file) {
        res.status(400).json({
          error: 'No file uploaded',
          message: 'CSV file is required'
        });
        return;
      }

      // Validate file type
      if (file.mimetype !== 'text/csv') {
        res.status(400).json({
          error: 'Invalid file type',
          message: 'Only CSV files are allowed'
        });
        return;
      }

      // Process the CSV to extract fields
      const result = await bulkAddContactsService.processInitialCSV(file.buffer);

      console.log(`✅ Step 1 complete: found ${result.fields.length} fields in ${result.rowCount} rows`);
      
      res.status(200).json({
        success: true,
        fields: result.fields,
        rowCount: result.rowCount
      });

    } catch (error) {
      console.error('❌ Error in bulkUploadStep1:', error);
      
      res.status(500).json({
        error: 'Internal server error',
        message: error instanceof Error ? error.message : 'Unknown error occurred'
      });
    }
  }

  async bulkUploadStep2(req: Request, res: Response): Promise<void> {
    try {
      const { tenantId } = req.params;
      const file = req.file;
      const fieldMappingsString = req.body.fieldMappings;

      console.log(`🗺️  Bulk upload step 2 for tenant ${tenantId}`);

      // Validate required parameters
      if (!tenantId) {
        res.status(400).json({
          error: 'Missing required parameters',
          message: 'tenantId is required'
        });
        return;
      }

      // Validate file upload
      if (!file) {
        res.status(400).json({
          error: 'No file uploaded',
          message: 'CSV file is required'
        });
        return;
      }

      // Validate field mappings
      if (!fieldMappingsString) {
        res.status(400).json({
          error: 'Missing field mappings',
          message: 'Field mappings are required'
        });
        return;
      }

      let fieldMappings: FieldMapping[];
      try {
        fieldMappings = JSON.parse(fieldMappingsString);
      } catch (parseError) {
        res.status(400).json({
          error: 'Invalid field mappings',
          message: 'Field mappings must be valid JSON'
        });
        return;
      }

      // Process the CSV with field mappings to create contacts
      const result = await bulkAddContactsService.processMappedCSV(file.buffer, fieldMappings, tenantId);

      console.log(`✅ Step 2 complete: ${result.success} created, ${result.failed} failed`);
      
      res.status(200).json({
        ...result,
        success: true
      });

    } catch (error) {
      console.error('❌ Error in bulkUploadStep2:', error);
      
      res.status(500).json({
        error: 'Internal server error',
        message: error instanceof Error ? error.message : 'Unknown error occurred'
      });
    }
  }

  async findContact(req: Request, res: Response): Promise<void> {
    try {
      const { tenantId } = req.params;
      const { channel, value } = req.body;

      console.log(`🔍 Finding contact for tenant ${tenantId}, channel: ${channel}, value: ${value}`);

      // Validate required parameters
      if (!tenantId) {
        res.status(400).json({
          error: 'Missing required parameters',
          message: 'tenantId is required'
        });
        return;
      }

      if (!channel || !value) {
        res.status(400).json({
          error: 'Missing required fields',
          message: 'channel and value are required'
        });
        return;
      }

      // Validate channel
      if (channel !== 'SMS' && channel !== 'EMAIL') {
        res.status(400).json({
          error: 'Invalid channel',
          message: 'channel must be either SMS or EMAIL'
        });
        return;
      }

      let contactId: string | null = null;

      // Find contact based on channel
      if (channel === 'SMS') {
        contactId = await smsChannelFinder.findContactByPhoneNumber({
          tenantId,
          phoneNumber: value
        });
      } else if (channel === 'EMAIL') {
        // TODO: Implement email finder when ready
        res.status(501).json({
          error: 'Not implemented',
          message: 'EMAIL channel finder not yet implemented'
        });
        return;
      }

      // If contact found, retrieve full contact details
      if (contactId) {
        const contact = await manageContactsService.getContact(tenantId, contactId);

        console.log(`✅ Found contact ${contactId}`);

        res.status(200).json({
          success: true,
          found: true,
          contactId,
          contact
        });
      } else {
        console.log(`❌ Contact not found for ${channel}: ${value}`);

        res.status(200).json({
          success: true,
          found: false,
          contactId: null,
          contact: null
        });
      }

    } catch (error) {
      console.error('❌ Error in findContact:', error);

      res.status(500).json({
        error: 'Internal server error',
        message: error instanceof Error ? error.message : 'Unknown error occurred'
      });
    }
  }

  async deleteContact(req: Request, res: Response): Promise<void> {
    try {
      const { tenantId, contactId } = req.params;

      console.log(`🗑️  Delete contact ${contactId} for tenant ${tenantId}`);

      // Validate required parameters
      if (!tenantId || !contactId) {
        res.status(400).json({
          error: 'Missing required parameters',
          message: 'tenantId and contactId are required'
        });
        return;
      }

      // Delete the contact using the service
      await contactDeletionService.deleteContact(tenantId, contactId);

      console.log(`✅ Successfully deleted contact ${contactId}`);
      
      res.status(200).json({
        success: true,
        message: 'Contact deleted successfully',
        contactId
      });

    } catch (error) {
      console.error('❌ Error in deleteContact:', error);
      
      res.status(500).json({
        error: 'Internal server error',
        message: error instanceof Error ? error.message : 'Unknown error occurred'
      });
    }
  }

  async bulkDeleteContacts(req: Request, res: Response): Promise<void> {
    try {
      const { tenantId } = req.params;
      const { contactIds } = req.body;

      console.log(`🗑️  Bulk delete contacts for tenant ${tenantId}`, { contactIds });

      // Validate required parameters
      if (!tenantId) {
        res.status(400).json({
          error: 'Missing required parameters',
          message: 'tenantId is required'
        });
        return;
      }

      // Validate contactIds
      if (!contactIds || !Array.isArray(contactIds) || contactIds.length === 0) {
        res.status(400).json({
          error: 'Invalid contact IDs',
          message: 'contactIds must be a non-empty array'
        });
        return;
      }

      // Use the contact deletion service to perform actual deletions
      const result = await contactDeletionService.bulkDeleteContacts(tenantId, contactIds);

      console.log(`✅ Bulk delete complete: ${result.deleted} deleted, ${result.failed} failed`);
      
      res.status(200).json({
        success: true,
        ...result
      });

    } catch (error) {
      console.error('❌ Error in bulkDeleteContacts:', error);
      
      res.status(500).json({
        error: 'Internal server error',
        message: error instanceof Error ? error.message : 'Unknown error occurred'
      });
    }
  }

  async createUserNote(req: Request, res: Response): Promise<void> {
    try {
      const { tenantId, contactId } = req.params;
      const { content } = req.body;
      const user = (req as any).user; // From Firebase auth middleware

      console.log(`=📝 Creating user note for contact ${contactId} by user ${user?.uid}`);

      // Validate required parameters
      if (!tenantId || !contactId) {
        res.status(400).json({
          error: 'Missing required parameters',
          message: 'tenantId and contactId are required'
        });
        return;
      }

      // Validate content
      if (!content || !content.trim()) {
        res.status(400).json({
          error: 'Missing required field',
          message: 'content is required'
        });
        return;
      }

      // Validate user is authenticated
      if (!user || !user.uid) {
        res.status(401).json({
          error: 'Unauthorized',
          message: 'User authentication required'
        });
        return;
      }

      const request: CreateUserNoteRequest = {
        tenantId,
        contactId,
        content: content.trim(),
        authorId: user.uid,
        authorName: user.name || user.displayName || user.email?.split('@')[0] || 'Unknown User',
        authorEmail: user.email || '',
        authorAvatarUrl: user.picture || user.photoURL || user.avatarUrl
      };

      console.log('🔍 User object for note creation:', {
        uid: user.uid,
        name: user.name,
        displayName: user.displayName,
        email: user.email,
        picture: user.picture,
        photoURL: user.photoURL,
        avatarUrl: user.avatarUrl,
        fullUserObject: user
      });

      const userNote = await manageContactsService.createUserNote(request);

      console.log(`✅ Successfully created user note ${userNote.id}`);
      
      res.status(201).json({
        success: true,
        message: 'User note created successfully',
        note: userNote
      });

    } catch (error) {
      console.error('❌ Error in createUserNote:', error);
      
      res.status(500).json({
        error: 'Internal server error',
        message: error instanceof Error ? error.message : 'Unknown error occurred'
      });
    }
  }

  async getUserNotes(req: Request, res: Response): Promise<void> {
    try {
      const { tenantId, contactId } = req.params;

      console.log(`=📋 Getting user notes for contact ${contactId}`);

      // Validate required parameters
      if (!tenantId || !contactId) {
        res.status(400).json({
          error: 'Missing required parameters',
          message: 'tenantId and contactId are required'
        });
        return;
      }

      const notes = await manageContactsService.getUserNotes(tenantId, contactId);

      console.log(`✅ Successfully retrieved ${notes.length} user notes`);
      
      res.status(200).json({
        success: true,
        notes
      });

    } catch (error) {
      console.error('❌ Error in getUserNotes:', error);
      
      res.status(500).json({
        error: 'Internal server error',
        message: error instanceof Error ? error.message : 'Unknown error occurred'
      });
    }
  }

  async updateUserNote(req: Request, res: Response): Promise<void> {
    try {
      const { tenantId, contactId, noteId } = req.params;
      const { content } = req.body;
      const user = (req as any).user; // From Firebase auth middleware

      console.log(`=✏️ Updating user note ${noteId} for contact ${contactId}`);

      // Validate required parameters
      if (!tenantId || !contactId || !noteId) {
        res.status(400).json({
          error: 'Missing required parameters',
          message: 'tenantId, contactId, and noteId are required'
        });
        return;
      }

      // Validate content
      if (!content || !content.trim()) {
        res.status(400).json({
          error: 'Missing required field',
          message: 'content is required'
        });
        return;
      }

      // Validate user is authenticated
      if (!user || !user.uid) {
        res.status(401).json({
          error: 'Unauthorized',
          message: 'User authentication required'
        });
        return;
      }

      const request: UpdateUserNoteRequest = {
        tenantId,
        contactId,
        noteId,
        content: content.trim(),
        authorId: user.uid
      };

      await manageContactsService.updateUserNote(request);

      console.log(`✅ Successfully updated user note ${noteId}`);
      
      res.status(200).json({
        success: true,
        message: 'User note updated successfully'
      });

    } catch (error) {
      console.error('❌ Error in updateUserNote:', error);
      
      if (error instanceof Error && error.message.includes('Unauthorized')) {
        res.status(403).json({
          error: 'Forbidden',
          message: error.message
        });
        return;
      }
      
      res.status(500).json({
        error: 'Internal server error',
        message: error instanceof Error ? error.message : 'Unknown error occurred'
      });
    }
  }

  async deleteUserNote(req: Request, res: Response): Promise<void> {
    try {
      const { tenantId, contactId, noteId } = req.params;
      const user = (req as any).user; // From Firebase auth middleware

      console.log(`=🗑️ Deleting user note ${noteId} for contact ${contactId}`);

      // Validate required parameters
      if (!tenantId || !contactId || !noteId) {
        res.status(400).json({
          error: 'Missing required parameters',
          message: 'tenantId, contactId, and noteId are required'
        });
        return;
      }

      // Validate user is authenticated
      if (!user || !user.uid) {
        res.status(401).json({
          error: 'Unauthorized',
          message: 'User authentication required'
        });
        return;
      }

      await manageContactsService.deleteUserNote(tenantId, contactId, noteId, user.uid);

      console.log(`✅ Successfully deleted user note ${noteId}`);
      
      res.status(200).json({
        success: true,
        message: 'User note deleted successfully'
      });

    } catch (error) {
      console.error('❌ Error in deleteUserNote:', error);
      
      if (error instanceof Error && error.message.includes('Unauthorized')) {
        res.status(403).json({
          error: 'Forbidden',
          message: error.message
        });
        return;
      }
      
      res.status(500).json({
        error: 'Internal server error',
        message: error instanceof Error ? error.message : 'Unknown error occurred'
      });
    }
  }
}

export const contactController = new ContactController();