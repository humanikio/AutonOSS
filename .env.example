# ===========================================
# Auton - Docker Compose Environment
# ===========================================
# Copy this file to .env and fill in your values
# Then run: docker compose up --build

# ===== FIREBASE ADMIN (backend - required) =====
FIREBASE_PROJECT_ID=your-firebase-project-id
# Paste the full private key including header/footer, with literal \n between lines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ===== FIREBASE WEB CONFIG (frontend - required) =====
# Get these from Firebase Console > Project Settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ===== BACKEND (required) =====
JWT_SECRET=generate-a-long-random-string-here
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ===== FRONTEND API (required) =====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ===== TWILIO (required for SMS/voice) =====
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== ELEVENLABS (required for AI voice agents) =====
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_TOOLS_API_KEY=your-elevenlabs-agent-tools-key

# ===== AI PROVIDERS (at least one required) =====
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_AI_API_KEY=your-google-ai-api-key

# ===== MAILGUN (optional - email) =====
MAILGUN_SENDING_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DEFAULT_DOMAIN=mail.your-domain.com

# ===== GOOGLE OAUTH (optional - calendar integration) =====
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ===== GOHIGHLEVEL (optional) =====
GHL_API_KEY=

# ===== N8N (optional - run with: docker compose --profile n8n up) =====
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
N8N_WEBHOOK_URL=http://localhost:5678

# ===== PORT OVERRIDES (optional) =====
# API_PORT=8000
# WEB_PORT=3000
# N8N_PORT=5678
